# ─────────────────────────────────────────────
# Tender Management Platform — Environment Config
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── PostgreSQL ──────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=tender_secret_pass
POSTGRES_DB=tender_management

DATABASE_URL=postgresql://tender_user:tender_secret_pass@postgres:5432/tender_management

# ── Redis ───────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── JWT ─────────────────────────────────────
JWT_SECRET=tender_management_jwt_super_secret_key_2026_production
JWT_EXPIRES_IN=24h

# ── MinIO ───────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=tender_minio_access
MINIO_SECRET_KEY=tender_minio_secret
MINIO_BUCKET=tender-documents
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# ── AI Service (Python FastAPI) ──────────────
AI_SERVICE_URL=http://ai-service:8001
GEMINI_API_KEY=your_gemini_api_key_here

# ── ClamAV ──────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ── NestJS Backend ───────────────────────────
BACKEND_PORT=3001
NODE_ENV=development

# ── Next.js Frontend ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=http://localhost
NEXT_PUBLIC_SENTRY_DSN=

# ── Sentry ───────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
